{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice-Dict",
  "version": "0.1.0",
  "identifier": "com.voice-dict.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice-Dict",
        "width": 400,
        "height": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "minWidth": 350,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local voice dictation with Whisper",
    "longDescription": "Voice-Dict is a local-first voice dictation app that transcribes speech to text using Whisper and injects it into any application."
  }
}
